# Keep the reviewable Genus environment and reports, but ignore transient tool
# databases and local scratch files generated by interactive runs.
/genus2invs__*/
/fv/
/mp_data/
/.z*
/.rs_*.tstamp
/scheduling_file.cts.*

# Local-only large artifacts. GitHub rejects files above 100 MB and warns above
# 50 MB; keep these in the remote server/workstation copy or regenerate them.
/results/outputs/fa_accel_top/fa_accel_top_mapped.v
/results/outputs/fa_accel_top/fa_accel_top.db
/workspace/LIBS/sky130_fd_sc_hs__tt_025C_1v80.lib

# Local workspaces, extracted bundles, and scratch directories that are not part
# of the reproducible baseline deliverable.
/another_workspace/
/artifacts/
/sim/xcelium_baseline/power/joules/
