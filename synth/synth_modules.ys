# Yosys synthesis — synthesize leaf modules individually to control memory

# ==========================================
# Module 1: fa_exp_approx
# ==========================================
read_verilog -sv -I rtl_yosys rtl_yosys/fa_exp_approx.sv
hierarchy -top fa_exp_approx
proc; opt; fsm; opt; memory; opt; techmap; opt
write_verilog -noattr synth/fa_exp_approx_netlist.v
design -reset

