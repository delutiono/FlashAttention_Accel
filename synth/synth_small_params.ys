# Yosys synthesis — small parameters (D=8) for fast gate-level sim validation
# Only synthesize modules actually used in the scheduler hierarchy

# ==========================================
# Module 1: fa_recip_approx (no D dependency)
# ==========================================
read_verilog -sv -I rtl_yosys rtl_yosys/fa_recip_approx.sv
hierarchy -top fa_recip_approx
proc; opt; fsm; opt; memory; opt; techmap; opt
write_verilog -noattr synth/fa_recip_approx_netlist_small.v
design -reset

# ==========================================
# Module 2: fa_dot_pe (D=8, LANES=4)
# ==========================================
read_verilog -sv -I rtl_yosys rtl_yosys/fa_dot_pe.sv
hierarchy -top fa_dot_pe
chparam -set D 8 fa_dot_pe
chparam -set LANES 4 fa_dot_pe
proc; opt; fsm; opt; memory; opt; techmap; opt
write_verilog -noattr synth/fa_dot_pe_netlist_small.v
design -reset

# ==========================================
# Module 3: fa_exp_approx (no D dependency)
# ==========================================
read_verilog -sv -I rtl_yosys rtl_yosys/fa_exp_approx.sv
hierarchy -top fa_exp_approx
proc; opt; fsm; opt; memory; opt; techmap; opt
write_verilog -noattr synth/fa_exp_approx_netlist_small.v
design -reset

# ==========================================
# Module 4: fa_softmax_online (D=8, V_ACC_LANES=4)
# ==========================================
read_verilog -sv -I rtl_yosys rtl_yosys/fa_exp_approx.sv rtl_yosys/fa_softmax_online.sv
hierarchy -top fa_softmax_online
chparam -set D 8 fa_softmax_online
chparam -set V_ACC_LANES 4 fa_softmax_online
proc; opt; fsm; opt; memory; opt; techmap; opt
write_verilog -noattr synth/fa_softmax_online_netlist_small.v
design -reset

# ==========================================
# Module 5: fa_regfile (no D dependency)
# ==========================================
read_verilog -sv -I rtl_yosys rtl_yosys/fa_defines.vh rtl_yosys/fa_regfile.sv
hierarchy -top fa_regfile
proc; opt; fsm; opt; memory; opt; techmap; opt
write_verilog -noattr synth/fa_regfile_netlist_small.v
design -reset
