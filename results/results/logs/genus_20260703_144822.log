  if {!$physical_floorplan_ready && !$allow_physical_fallback} {
    error "GENUS_PHYSICAL=1 requires a successful predict_floorplan result. Set GENUS_ALLOW_PHYSICAL_FALLBACK=1 only for debug logical fallback runs."
  }
