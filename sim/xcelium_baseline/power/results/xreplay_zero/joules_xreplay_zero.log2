@file(run_fa_top_xreplay_zero.tcl) 156: if {![info exists ::env(JOULES_VERILOG_MODEL_STARTUP_FILE)] || $::env(JOULES_VERILOG_MODEL_STARTUP_FILE) eq ""} {
