@file(run_fa_top_xreplay_zero.tcl) 162: set xreplay_cmd [list xreplay \
  -initial_state_point_value rtlstim \
  -timescale 1ns/1ps \
  -map_file $mapping_file \
  -xrun_path $xrun_path \
  -rtl_stim $rtl_stim \
  -stim_format $rtl_stim_format \
  -dut_instance $dut_instance \
  -delay_mode zero \
  -out $replayed_stim \
  -stim_annotation state]
@file(run_fa_top_xreplay_zero.tcl) 174: if {$use_model_files eq "1"} {
  # Fallback mode only.  Default is startup-file mode because -verilog_model_files
  # caused unresolved base stdcell modules in the uploaded log.
  lappend xreplay_cmd -verilog_model_files $verilog_model_files
} else {
  lappend xreplay_cmd -verilog_model_startup_file $startup_file
}
